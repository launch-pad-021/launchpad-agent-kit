{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Launchpad risk classification",
  "type": "object",
  "required": ["level", "status", "agent_config", "reasons"],
  "additionalProperties": false,
  "properties": {
    "level": { "enum": ["low", "medium", "high"] },
    "status": { "enum": ["risk/low", "risk/medium", "risk/high"] },
    "agent_config": { "type": "boolean" },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "oneOf": [
    { "properties": { "level": { "const": "low" }, "status": { "const": "risk/low" } } },
    { "properties": { "level": { "const": "medium" }, "status": { "const": "risk/medium" } } },
    { "properties": { "level": { "const": "high" }, "status": { "const": "risk/high" } } }
  ]
}
